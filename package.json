{
  "name": "discstation",
  "version": "0.1.21",
  "description": "DiscStation optical-media appliance host — one cross-OS installer",
  "bin": {
    "discstation-setup": "scripts/setup.mjs",
    "discstation": "scripts/open.mjs"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs"
  },
  "engines": {
    "node": ">=16"
  },
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "files": [
    "scripts/",
    "src/*.py",
    "src/static/",
    "src/win/",
    "arduino/",
    "systemd/",
    "docs/",
    "install.sh",
    "install-macos.sh",
    "install-windows.ps1",
    "requirements.txt",
    "requirements-optional.txt",
    "discstation.env.example",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phuju/dvd-station.git"
  },
  "keywords": [
    "dvd",
    "cd",
    "optical",
    "burn",
    "rip",
    "appliance"
  ],
  "license": "MIT",
  "private": false
}
